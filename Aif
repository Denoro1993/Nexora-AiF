🏢 4. TENANT-AWARE ORCHESTRATOR

Every task is now scoped per organization.

def run_task(task, user):

    org_id = user["org_id"]

    trace = []

    steps = plan(task)

    results = []

    for step in steps:
        results.append(execute(step))

    store_task(org_id, user["user_id"], task)

    return {
        "org_id": org_id,
        "task": task,
        "results": results
    }


